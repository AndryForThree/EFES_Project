# Aggiorna solo le schede nel documento del telaio gia generato.
from pathlib import Path
import importlib.util
import FreeCAD as App
import FreeCADGui as Gui

CARTELLA = Path(__file__).resolve().parent
FILE_SCHEDE = CARTELLA/'schede.json'
doc = App.getDocument('Meccanismo_Sterzo')
if doc is None:
    raise ValueError('Eseguire prima Sterzo.FCMacro.')
spec = importlib.util.spec_from_file_location('schede_cad', CARTELLA/'schede_cad.py')
schede = importlib.util.module_from_spec(spec)
spec.loader.exec_module(schede)
schede.genera(doc, FILE_SCHEDE)
App.setActiveDocument(doc.Name)
Gui.activeDocument().activeView().viewAxonometric()
Gui.activeDocument().activeView().fitAll()
