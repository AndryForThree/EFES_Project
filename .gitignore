# Quartus: compilation databases and programming outputs.
# Keep .qpf, .qsf, HDL sources, IP definitions and constraints.
/FPGA/**/db/
/FPGA/**/incremental_db/
/FPGA/**/output_files/
/FPGA/**/*.qws

# Quartus-generated simulation files; keep testbenches and scripts.
/FPGA/simulation/**/*.vho
/FPGA/simulation/**/*.vo
/FPGA/simulation/**/*.sft

# Unit tests: compiled executables and generated outputs.
/FPGA/tests/*/outputs/

# LaTeX build files (bibliography sources and figures stay tracked).
/Deliveries/**/*.aux
/Deliveries/**/*.log
/Deliveries/**/*.bbl
/Deliveries/**/*.bcf
/Deliveries/**/*.blg
/Deliveries/**/*.lof
/Deliveries/**/*.lot
/Deliveries/**/*.out
/Deliveries/**/*.toc
/Deliveries/**/*.run.xml
/Deliveries/**/*.synctex.gz
/Deliveries/**/*.fls
/Deliveries/**/*.fdb_latexmk

# Compiled reports only; keep reference PDFs and appendix documents.
/Deliveries/*Report/main.pdf
/Deliveries/IntroReport/Andrea Viola s349537_Project proposal report.pdf

# Local editor/workspace state; keep portable project/build configuration.
.vscode/
.settings/
.metadata/
.cache/

# Python-generated caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editor backups and operating-system metadata.
*.bak
*~
*.swp
*.swo
.DS_Store
Thumbs.db
