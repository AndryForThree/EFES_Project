# Quartus: compilation databases and programming outputs.
# Keep .qpf, .qsf, HDL sources, IP definitions and constraints.
/FPGA/**/db/
/FPGA/**/incremental_db/
/FPGA/**/output_files/
/FPGA/**/*.qws

# Quartus-generated simulation files; keep testbenches and scripts.
/FPGA/simulation/**/*.vho
/FPGA/simulation/**/*.vo
/FPGA/simulation/**/*.sft

# Unit tests: compiled executables and generated outputs.
/FPGA/tests/*/outputs/

# LaTeX build files (bibliography sources and figures stay tracked).
/Deliveries/**/*.aux
/Deliveries/**/*.log
/Deliveries/**/*.bbl
/Deliveries/**/*.bcf
/Deliveries/**/*.blg
/Deliveries/**/*.lof
/Deliveries/**/*.lot
/Deliveries/**/*.out
/Deliveries/**/*.toc
/Deliveries/**/*.run.xml
/Deliveries/**/*.synctex.gz
/Deliveries/**/*.fls
/Deliveries/**/*.fdb_latexmk

# Compiled reports only; keep reference PDFs and appendix documents.
/Deliveries/*Report/main.pdf
/Deliveries/IntroReport/Andrea Viola s349537_Project proposal report.pdf

# Local editor/workspace state; keep portable project/build configuration.
.vscode/
.settings/
.metadata/
.cache/

# Python-generated caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Keep only font inputs actually used by fonts.json, plus licenses/readmes.
# Downloaded families contain many unused weights and variable-font versions.
# When adding a new source to fonts.json, add its exception here too.
/Firmware/Scripts/FontGeneration/baseFonts/**
!/Firmware/Scripts/FontGeneration/baseFonts/**/
!/Firmware/Scripts/FontGeneration/baseFonts/**/README*
!/Firmware/Scripts/FontGeneration/baseFonts/**/OFL.txt
!/Firmware/Scripts/FontGeneration/baseFonts/**/LICENSE*
!/Firmware/Scripts/FontGeneration/baseFonts/Barlow_Condensed/BarlowCondensed-Bold.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Barlow_Semi_Condensed/BarlowSemiCondensed-Bold.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Exo_2/static/Exo2-Bold.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Inter/static/Inter_18pt-Medium.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Inter/static/Inter_18pt-SemiBold.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Rajdhani/Rajdhani-Bold.ttf
!/Firmware/Scripts/FontGeneration/baseFonts/Rajdhani/Rajdhani-SemiBold.ttf

# Editor backups and operating-system metadata.
*.bak
*~
*.swp
*.swo
.DS_Store
Thumbs.db
