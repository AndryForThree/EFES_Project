
# ============================================================================
# On-board CLOCKs
# ============================================================================
# The board provides two physical oscillators:
#   - 50 MHz oscillator
#   - 27 MHz oscillator
#
# Each oscillator is routed by the PCB to two dedicated clock-capable pins
# of the Cyclone IV FPGA.
#
# IMPORTANT:
# The two pins belonging to the same oscillator do NOT provide independent
# clock sources. They carry the same physical clock signal because they are
# connected to the same net on the PCB. For this reason the suffixes "_A" 
# and "_B" only identify the two distinct FPGA pins receiving the same board clock.

# ----------------------------------------------------------------------------
# 50 MHz on-board oscillator
# ----------------------------------------------------------------------------
set_location_assignment PIN_24 -to CLK_50M_A
set_location_assignment PIN_25 -to CLK_50M_B

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLK_50M_A
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLK_50M_B


# ----------------------------------------------------------------------------
# 27 MHz on-board oscillator
# ----------------------------------------------------------------------------
set_location_assignment PIN_90 -to CLK_27M_A
set_location_assignment PIN_91 -to CLK_27M_B

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLK_27M_A
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLK_27M_B


#============================================================
# Reset
#============================================================
set_location_assignment PIN_88 -to RESET_N
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to RESET_N

#============================================================
# On-Board LEDs
#============================================================
set_location_assignment PIN_1  -to LEDS[0]
set_location_assignment PIN_2  -to LEDS[1]
set_location_assignment PIN_3  -to LEDS[2]
set_location_assignment PIN_7  -to LEDS[3]
set_location_assignment PIN_11 -to LEDS[4]

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to LEDS[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to LEDS[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to LEDS[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to LEDS[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to LEDS[0]


#============================================================
# On-Board BUTTONs
#============================================================
set_location_assignment PIN_73 -to BUTTONS[3]
set_location_assignment PIN_80 -to BUTTONS[2]
set_location_assignment PIN_89 -to BUTTONS[1]
set_location_assignment PIN_114 -to BUTTONS[0]

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to BUTTONS[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to BUTTONS[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to BUTTONS[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to BUTTONS[0]


#============================================================
# On-Board FLASH Memory
#============================================================
# 64 Mbit (8 MB) general-purpose Serial NOR Flash memory.
#
# Connected directly to the FPGA through SPI.
# WP# and HOLD# are tied to 3.3 V on the board, therefore
# Standard SPI and Dual SPI are available, but Quad SPI is not.
#
# Signal direction is relative to the FPGA.

set_location_assignment PIN_74 -to FLASH_MOSI
set_location_assignment PIN_75 -to FLASH_SCK
set_location_assignment PIN_84 -to FLASH_MISO
set_location_assignment PIN_87 -to FLASH_CS_N

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FLASH_MOSI
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FLASH_SCK
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FLASH_MISO
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FLASH_CS_N


#============================================================
# Serial communication
#============================================================
# SERIAL_TX Direction: FPGA		-> USB-C
# SERIAL_RX Direction: USB-C	-> FPGA
set_location_assignment PIN_10 -to SERIAL_TX
set_location_assignment PIN_23 -to SERIAL_RX

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to SERIAL_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to SERIAL_RX


#============================================================
# General-Purpose I/O
#============================================================
#
# Naming convention:
#   IO_<FPGA physical pin>_BANK<bank number>
#
# Only FPGA I/O pins physically exposed on the board headers
# are listed here.
#
# IMPORTANT:
#   Banks 3 and 4 are powered by VIOB (See connector J5).
#   Banks 7 and 8 are powered by VIOC (See connector J6).
#
#   VIOB and VIOC are configurable board I/O supply rails.
#   Therefore the IO_STANDARD for these pins MUST match the
#   voltage selected on the board.
#
#   For this reason no fixed IO_STANDARD is specified here.
#============================================================

#------------------------------------------------------------
# BANK 2
#------------------------------------------------------------

set_location_assignment PIN_28 -to IO_28_BANK2
set_location_assignment PIN_30 -to IO_30_BANK2
set_location_assignment PIN_31 -to IO_31_BANK2
set_location_assignment PIN_32 -to IO_32_BANK2
set_location_assignment PIN_33 -to IO_33_BANK2
