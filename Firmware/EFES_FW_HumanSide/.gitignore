# This repository stores CubeMX INPUTS and custom code, not its generated SDK.
# After cloning, regenerate from .ioc before configuring/building the firmware.
# Keep the customized root CMakeLists.txt, .ioc, .clangd and documentation.

# Stock HAL/CMSIS and any Cube-generated middleware are regenerated by CubeMX.
/Drivers/
/Middlewares/

# Keep only custom code in the generated Core tree.
# Keep main.c USER CODE sections, HAL callbacks and the custom App.c/App.h.
# They cannot be reconstructed from the .ioc file.
/Core/*
!/Core/Inc/
/Core/Inc/*
!/Core/Inc/App.h
!/Core/Src/
/Core/Src/*
!/Core/Src/main.c
!/Core/Src/stm32g4xx_it.c
!/Core/Src/App.c

# CubeMX/CMake project outputs; the root CMakeLists.txt is customized and kept.
/cmake/
/CMakePresets.json
/startup_stm32*.s
/STM32*.ld
/.project
/.cproject

# Build directories: ignore the whole generated tree, whatever its contents.
build/
cmake-build-*/
Debug/
Release/

# CMake/Ninja output, including accidental in-source builds.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
*.ninja
.ninja_*
Makefile

# Compiler/linker/debug artifacts generated outside the build directories.
*.o
*.obj
*.elf
*.axf
*.hex
*.bin
*.map
*.d
*.su
*.gcda
*.gcno
*.gcov
*.list
*.lst

# CubeMX regeneration bookkeeping and scratch data; .ioc is the input.
.mxproject
mx.scratch

# Machine-specific CMake overrides (editor/workspace rules are in root .gitignore).
CMakeUserPresets.json
