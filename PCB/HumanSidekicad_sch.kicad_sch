	(text "EMI Filtering"
		(exclude_from_sim no)
		(at 373.126 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.4572)
				(bold yes)
			)
		)
		(uuid "12204514-d8e4-4a5d-bf7a-5dbc7f4852b6")
	)
	(text "nRST circuit generates a signal that is normally \nHIGH (no reset), and LOW when button is pressed \n(reset). the capacitor is used to filter this \nsignal, and in particular avoid noise and EMI to \ntrigger the reset condition."
		(exclude_from_sim no)
		(at 274.066 131.572 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "154652c6-4f51-457a-8602-ef624013b01d")
	)
