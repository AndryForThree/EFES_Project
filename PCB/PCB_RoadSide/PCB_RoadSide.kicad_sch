		(uuid "156859b4-be2a-4926-9c09-8978c8f3a725")
	)
	(text ""
		(exclude_from_sim no)
		(at 130.048 77.216 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "24e9740d-88fb-4530-be5d-30f7a66c36cc")
	)
	(text "The Human Side requires two main voltage levels: 5V and 3.3V. The 5V rail supplies the CAN\ntransceiver and the Steering Wheel Sensor PCB, where local LDOs generate a stable 3.3V supply \nfor the analog circuitry. The 3.3V rail powers the Human Side\n electronics, including\nsignificant loads such as the display and LEDs.\n\nBoth rails are generated directly from the main 12V vehicle supply using DC/DC buck \nconverters, chosen for their high efficiency and reduced heat dissipation.\n\nAlthough 3.3V could be generated from the 5V rail through an LDO, a dedicated buck \nconverter was preferred due to the significant current consumption and possible \nfuture expansions. This \nalso avoids the additional losses associated with a cascaded power supply."
		(exclude_from_sim no)
		(at 182.372 122.174 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "27bdb55c-cf12-4d96-8e6a-0391241d3db0")
	)
	(text "Motor output should be mechanically linked \nto a 10kOhm Potentiometer, which is \nconnected to the Board for sensing purposes."
		(exclude_from_sim no)
		(at 330.708 89.662 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "29b74d78-dc38-44f3-a348-d7a4b7da75c5")
	)
	(text "Servo Potentiometer Position"
		(exclude_from_sim no)
		(at 289.814 81.534 0)
		(effects
