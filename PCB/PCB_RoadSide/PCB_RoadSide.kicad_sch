			)
		)
		(uuid "4d1b96e1-3432-487b-88dc-bfacf5a4e183")
	)
	(text "Motor Position"
		(exclude_from_sim no)
		(at 99.06 61.976 0)
		(effects
			(font
				(size 2.286 2.286)
				(thickness 0.4572)
