			)
		)
		(uuid "8455bbf2-937f-4d09-be10-de6fd94229ec")
	)
	(text "Motor Supply (12V) Monitor"
		(exclude_from_sim no)
		(at 261.112 245.11 0)
		(effects
			(font
				(size 2.286 2.286)
				(thickness 0.4572)
				(bold yes)
			)
		)
		(uuid "8fd8eb3f-fcfd-4339-8130-e4d8980fe2bf")
	)
	(text "The chosen CAN transceiver uses a 5V supply for the bus interface \r\nand a 3.3V VIO supply for compatibility with the MCU logic levels.\r\nThe 5V supply provides more voltage headroom for the CAN output \r\nstage, making it easier to meet the required electrical and EMC \r\nperformance at a lower cost. In particular, it reduces the design\r\nconstraints on the internal circuitry compared to a transceiver \r\npowered entirely at 3.3V, reducing the component cost by a \r\nsignificant amount.\r\nAt the same time, the separate 3.3V VIO supply allows direct \r\ncommunication with the MCU without requiring additional level \r\nshifters."
		(exclude_from_sim no)
		(at 200.914 34.798 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "91e685a7-7d0c-4da6-b95f-37725ab03725")
	)
	(text "Interlock Start"
		(exclude_from_sim no)
		(at 326.898 75.438 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9ababa50-a36d-4896-a98e-398072ccf30b")
	)
