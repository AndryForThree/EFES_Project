	(text "\"Fault Simulation Connector\", which just disconnects\none of the Sensor outputs. Stuck-Open and \nStuck-to-GND faults can be simulated by this \nconnector"
		(exclude_from_sim no)
		(at 115.57 67.31 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "0313aeb3-a471-420a-981a-41cfd9476020")
	)
	(text "To be mounted ONLY \nin the case a 2nd order \nfilter is needed\n"
		(exclude_from_sim no)
		(at 85.09 53.848 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "07ad6b97-0347-42aa-8010-1c12f9a15c29")
	)
	(text "To be mounted ONLY \nin the case a 2nd order \nfilter is needed\n"
		(exclude_from_sim no)
		(at 83.82 159.258 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "15e10b2c-f58c-46b1-be54-f45e042ddac9")
	)
	(text "CHANNEL 2"
		(exclude_from_sim no)
		(at 27.94 143.256 0)
		(effects
			(font
				(size 2.286 2.286)
				(thickness 0.4572)
				(bold yes)
			)
		)
		(uuid "2f3a04a2-36b1-4499-bf67-f2301be92c84")
	)
	(text "Two INAs are used for each Channel, since both differential signals must be conditioned.\nThe amplifiers are placed before the MUXes in order to avoid discontinuities at their inputs,\nwhich would require a settling time before the amplifiers could accurately follow the input\nsignals again (this time is longer than the transition time imposed by the Slew Rate, since\nadditional settling is required, as defined in the INA's datasheet).\n\nThis architectural choice, although slightly more expensive (two additional INAs replace\ntwo MUXes), reduces the settling time required after each MUX switching event, allowing\nhigher sampling frequencies.\n\nSince the INAs continuously follow the sensor signals, their dynamic limitations now\nmainly affect the maximum analog signal frequency rather than the sampling frequency.\n\nThe INA500B has a typical Small-Signal Bandwidth of 135 kHz and a Slew Rate of\n0.18 V/us. Considering the maximum output signal amplitude (1.3 V), the theoretical\nFull-Power Bandwidth can be estimated as:\n\n    FPBW = SR / (2 * pi * A_max) = 22 kHz\n\nThis bandwidth is largely sufficient for the expected steering wheel dynamics.\nThe maximum sampling frequency is instead mainly limited by the settling time\nfollowing each MUX switching event and by the ADC conversion time.\n"
		(exclude_from_sim no)
		(at 245.364 34.798 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "34965221-41fd-4fca-ae12-44cfc569e2c0")
	)
	(text "1st Order Filter"
		(exclude_from_sim no)
		(at 59.69 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3a6b9dba-59be-47ce-82a7-0746c91e8984")
	)
	(text "1st Order Filter"
		(exclude_from_sim no)
		(at 60.96 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4924626b-003e-456d-9167-538dbfb8face")
	)
	(text "To be mounted ONLY \nin the case a 2nd order \nfilter is needed\n"
		(exclude_from_sim no)
		(at 85.09 94.488 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4b60898d-45f3-4c23-8eab-9ecd58393bf8")
	)
	(text "1st Order Filter"
		(exclude_from_sim no)
		(at 59.69 200.66 0)
		(effects
			(font
